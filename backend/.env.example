GROQ_API_KEY=your_groq_api_key_here
PORT=8787

# Optional. Leave unset to fall back to the browser's built-in speechSynthesis for
# spoken pose-check guidance. Set it to enable ElevenLabs (better voice quality, but a
# real metered free tier — control usage by adding/removing this key).
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional. Leave both unset and /api/schedule, /api/schedule/today, /api/sessions
# return 501 (everything else still works). Set both to enable login-gated schedules —
# from your OWN personal MongoDB Atlas + Clerk accounts, see dev_pending_actions.md.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# MONGODB_DB_NAME=yogapedia
# CLERK_SECRET_KEY=your_clerk_secret_key_here
# CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Optional. Leave unset and the weekly email summary is disabled entirely (the rest of
# the app is unaffected). Requires Mongo + Clerk also configured above — the summary is
# built from sessionLogs and sent to each user's real Clerk email. Needs a sender address
# verified in your Brevo account.
# BREVO_API_KEY=your_brevo_api_key_here
# BREVO_FROM_EMAIL=you@example.com
# BREVO_FROM_NAME=YogaPedia
# Used only by the manual "send me a test summary now" endpoint as the default recipient
# when testing without a signed-in Clerk session context.
# WEEKLY_SUMMARY_TEST_EMAIL=you@example.com
# "HH:MM" 24h, checked against the server's local time every few minutes — see
# backend/weeklySummaryScheduler.js. Only fires once per user per 7 days.
# WEEKLY_SUMMARY_SEND_TIME=06:30